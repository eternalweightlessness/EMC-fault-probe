# Repository and local services
EMC_PROJECT_ROOT=D:\path\to\EMC-fault-probe
EMC_OLLAMA_HOST=http://127.0.0.1:11434
EMC_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
EMC_EMBEDDING_MODEL=nomic-embed-text

# Backend behavior
EMC_BACKEND_HOST=127.0.0.1
EMC_BACKEND_PORT=8000
EMC_AUTO_START_OLLAMA=false
EMC_OLLAMA_THINK=true
EMC_MAX_AGENT_STEPS=5
EMC_CHROMA_COLLECTION=emc_faults

# Desktop client (development mode)
EMC_BACKEND_URL=http://127.0.0.1:8000/api/v1
EMC_DESKTOP_REQUEST_TIMEOUT=10
EMC_DESKTOP_STREAM_TIMEOUT=600
